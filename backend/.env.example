# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Google Sheet CSV or Sheet link (Leave empty to use sample_feedback.csv)
GOOGLE_SHEET_URL=

# Default notification channels (can also be entered in the UI)
DEFAULT_SLACK_WEBHOOK=
DEFAULT_EMAIL=
SLACK_BOT_TOKEN=

# Free HTTP Email APIs (recommended for cloud hosts like Render which block SMTP port 587)
# Resend: https://resend.com (3,000 free emails/mo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Laser AI <onboarding@resend.dev>

# Brevo: https://brevo.com (300 free emails/day to any recipient)
BREVO_API_KEY=

# Traditional SMTP (Works locally; blocked on Render Free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
