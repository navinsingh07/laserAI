# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Google Sheet CSV or Sheet link (Leave empty to use sample_feedback.csv)
GOOGLE_SHEET_URL=

# Default notification channels (can also be entered in the UI)
DEFAULT_SLACK_WEBHOOK=
DEFAULT_EMAIL=

# Optional SMTP settings for live email dispatch (if empty, simulation mode logs success)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
